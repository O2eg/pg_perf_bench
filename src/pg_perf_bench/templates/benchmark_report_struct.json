                "chart_initial_connection_time_ms": {
                    "header": "Initial connection time",
                    "description": "Initial connection time reported by pgbench; unavailable with --connect, which reports a different connection metric.",
                    "state": "collapsed",
                    "item_type": "chart",
                    "python_command": "chart_pgbench_metric",
